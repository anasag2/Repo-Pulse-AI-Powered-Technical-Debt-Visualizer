# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Public URL & site address ---------------------------------------------
# PRODUCTION:
#   PUBLIC_URL=https://repo-pulse.com
#   SITE_ADDRESS=repo-pulse.com        # Caddy auto-provisions HTTPS for this
# LOCAL DOCKER TEST:
#   PUBLIC_URL=http://localhost
#   SITE_ADDRESS=:80                   # plain HTTP, no certificate
PUBLIC_URL=https://repo-pulse.com
SITE_ADDRESS=repo-pulse.com

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# --- Social login (OAuth) — callback must be PUBLIC_URL/api/auth/<p>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI ---------------------------------------------------------------------
# Free chatbot tier (OpenRouter). Leave blank to require users to bring a key.
OPENROUTER_API_KEY=
# Optional: enables the Claude-powered file/repo insights.
ANTHROPIC_API_KEY=

# --- Email (password reset) -------------------------------------------------
# Resend API key. Leave blank in dev — the reset link is logged to the backend
# console instead of being emailed.
RESEND_API_KEY=
# Verified sender once the domain is set up in Resend.
EMAIL_FROM=Repo-Pulse <noreply@repo-pulse.com>
